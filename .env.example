# Application
ALLIANZ_ENVIRONMENT=local
ALLIANZ_LOG_LEVEL=INFO

# Local files
ALLIANZ_MANUAL_PATH=data/raw/Manual-cide-ascide-y-cicos.pdf
ALLIANZ_QDRANT_PATH=data/qdrant
ALLIANZ_QDRANT_COLLECTION_PREFIX=allianz_manual

# Local model runtime. No API key is required.
ALLIANZ_OLLAMA_BASE_URL=http://localhost:11434
ALLIANZ_OLLAMA_TIMEOUT_SECONDS=300
ALLIANZ_EMBEDDING_MODEL=qwen3-embedding:0.6b
ALLIANZ_EMBEDDING_BATCH_SIZE=8
ALLIANZ_LLM_MODEL=qwen3:4b

# Workflow limits
ALLIANZ_RETRIEVAL_TOP_K=6
ALLIANZ_MAX_AGENT_RETRIES=1
ALLIANZ_CHUNK_SIZE=1200
ALLIANZ_CHUNK_OVERLAP=150
